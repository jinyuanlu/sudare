{
  "name": "sudare",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "build": "pnpm --filter @sudare/web build",
    "dev": "pnpm build && pnpm --filter @sudare/server dev",
    "deploy": "pnpm build && pnpm --filter @sudare/server run deploy",
    "gen:vapid": "node scripts/gen-vapid.mjs",
    "spec": "sh spec/check.sh"
  },
  "packageManager": "pnpm@10.28.0"
}