{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sudare",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  // global_fetch_strictly_public: required for Client ID Metadata Documents (SSRF protection).
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "observability": { "enabled": true },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Everything dynamic goes through the Worker first; the rest is the PWA.
    "run_worker_first": ["/api/*", "/mcp", "/mcp/*", "/authorize", "/oauth/*", "/.well-known/*", "/admin/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "CONVERSATION", "class_name": "ConversationDO" },
      { "name": "PRINCIPAL", "class_name": "PrincipalDO" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ConversationDO", "PrincipalDO"] }],
  "d1_databases": [
    { "binding": "DB", "database_name": "sudare", "database_id": "REPLACE_WITH_D1_ID", "migrations_dir": "migrations" }
  ],
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "REPLACE_WITH_KV_ID" }],
  "triggers": { "crons": ["17 3 * * *"] },
  // Per-colo counters; a brake on abuse, not an exact quota.
  "ratelimits": [
    { "name": "RL_PUBLIC", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } },
    { "name": "RL_WRITE", "namespace_id": "1002", "simple": { "limit": 240, "period": 60 } }
  ],
  "vars": {
    // The one public origin of this deployment. Passkeys, OAuth and cookies are all bound to it.
    "PUBLIC_ORIGIN": "http://localhost:8787",
    // Extra https origins an OAuth client may redirect to (comma separated). Loopback is always allowed.
    "ALLOWED_REDIRECT_ORIGINS": "",
    // OAuth client ids trusted to run discussion rounds in a sandbox (comma separated).
    "ROUND_CLIENT_IDS": "",
    // "off" disables the in-plugin human session: every approval then happens in the PWA.
    "PLUGIN_HUMAN_SESSION": "on",
    "WEB_SESSION_HOURS": "168",
    "PLUGIN_SESSION_HOURS": "8",
    "VAPID_SUBJECT": "",
    "VAPID_PUBLIC_KEY": ""
  }
  // Secrets (wrangler secret put): ADMIN_SECRET, VAPID_PRIVATE_KEY
}
