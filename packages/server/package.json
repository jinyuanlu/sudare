{
  "name": "@sudare/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --config ${SUDARE_CONFIG:-wrangler.jsonc}",
    "migrate:local": "wrangler d1 migrations apply sudare --local",
    "migrate": "wrangler d1 migrations apply sudare --remote --config ${SUDARE_CONFIG:-wrangler.jsonc}",
    "typecheck": "tsc -p .",
    "test": "vitest run"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^1.2.4",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@simplewebauthn/server": "^14.1.0",
    "@sudare/protocol": "workspace:*",
    "hono": "^4.13.17",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.23.0",
    "@cloudflare/workers-types": "^5.20261110.1",
    "typescript": "^5.9.0",
    "vitest": "^4.1.0",
    "wrangler": "^4.159.0"
  },
  "license": "FSL-1.1-MIT"
}
